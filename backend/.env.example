# Copy to .env for local development. Never commit .env.

# PostgreSQL: matches the existing local Compose defaults.
DB_URL=jdbc:postgresql://localhost:5432/repofy
DB_USERNAME=project_user
DB_PASSWORD=project_password

# OAuth callback URL for local development: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=local-development-not-configured
GITHUB_CLIENT_SECRET=local-development-not-configured

# OpenAI is needed for embedding/indexing and AI chat; replace before using those features.
OPENAI_API_KEY=local-development-not-configured
OPENAI_CHAT_MODEL=gpt-3.5-turbo
OPENAI_CHAT_MAX_TOKENS=2048
OPENAI_CHAT_TEMPERATURE=0.7
OPENAI_CHAT_TOP_P=1.0
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_MAX_TOKENS=8191

# Required for token encryption. Generate a new password and 8-byte hex salt:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# The salt must be exactly 16 hexadecimal characters.
TOKEN_ENCRYPTOR_PASSWORD=replace-with-your-secret
TOKEN_ENCRYPTOR_SALT=replace-with-your-8-byte-hex-salt

# Local frontend URL used for OAuth redirects and CORS.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
